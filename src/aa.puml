```plantuml
@startuml
title Diagramme d'activité - Gestion de l'interface utilisateur ui.c

start

:Initialiser l'écran;
:Initialiser l'ADC;
:Initialiser l'enregistreur audio;

:menu_index = 0;
:audio_available = false;
:Réinitialiser l'état précédent des boutons;

:Afficher le menu principal;

repeat
    :Lire l'état des boutons;
    :Détecter les fronts montants;
    note right
      Un événement est pris en compte
      seulement si le bouton passe
      de relâché à appuyé.
    end note

    :Mettre à jour l'état précédent des boutons;

    if (Bouton haut ?) then (oui)
        if (menu_index > 0 ?) then (oui)
            :menu_index--;
            :Réafficher le menu;
        else (non)
            :Ne rien faire;
        endif

    elseif (Bouton bas ?) then (oui)
        if (menu_index < MENU_COUNT - 1 ?) then (oui)
            :menu_index++;
            :Réafficher le menu;
        else (non)
            :Ne rien faire;
        endif

    elseif (Bouton gauche ?) then (oui)
        :Réafficher le menu actuel;

    elseif (Bouton droite ?) then (oui)
        :Aucune action;

    elseif (Bouton centre ?) then (oui)

        if (Menu = Enregistrer ?) then (oui)
            :Afficher "Enregistrement";
            :Enregistrer l'audio avec ADC_2;
            :Afficher "Sauvegarde";
            :Sauvegarder l'audio en mémoire Flash;
            :audio_available = true;
            :Afficher "Enregistrement terminé";

        elseif (Menu = Lecture ?) then (oui)
            if (audio_available ?) then (oui)
                :Afficher "Lecture";
                :Initialiser le lecteur audio;
                :Lire l'audio depuis la mémoire Flash;
                :Réinitialiser l'écran;
                :Afficher "Lecture terminée";
            else (non)
                :Afficher un message indiquant qu'aucun audio n'est disponible;
            endif

        elseif (Menu = Afficher signal ?) then (oui)
            if (audio_available ?) then (oui)
                :Récupérer le buffer audio;
                :Récupérer le nombre d'échantillons;
                :Afficher le signal enregistré;
            else (non)
                :Afficher un message indiquant qu'aucun audio n'est disponible;
            endif
        endif

    else (aucun bouton)
        :Ne rien faire;
    endif

repeat while (Application en fonctionnement)

stop
@enduml
```
