@startuml
title Ajout d'une fraude constatée à un formulaire

actor "Utilisateur / Main" as User

participant "FormulaireFraude" as Formulaire
participant "Fraude" as Fraude
participant "Etudiant" as Etudiant
participant "LocalDate" as LocalDate
participant "LocalDateTime" as LocalDateTime

== Création du formulaire ==

User -> Formulaire : new FormulaireFraude()
activate Formulaire

Formulaire -> Formulaire : etudiants = new ArrayList<>()
Formulaire -> Formulaire : fraudes = new ArrayList<>()
Formulaire -> LocalDateTime : now()
LocalDateTime --> Formulaire : dateCreation
Formulaire -> Formulaire : dateDerniereModification = dateCreation

deactivate Formulaire

== Création de la fraude ==

User -> Fraude : new FraudePapier() / new FraudeIAG() / ...
activate Fraude

Fraude -> Fraude : etudiants = new ArrayList<>()
Fraude -> LocalDate : now()
LocalDate --> Fraude : dateReleve

deactivate Fraude

== Association des étudiants à la fraude ==

loop pour chaque étudiant concerné
    User -> Fraude : addEtudiant(etudiant)
    activate Fraude
    Fraude -> Fraude : etudiants.add(etudiant)
    deactivate Fraude
end

== Ajout de la fraude au formulaire ==

User -> Formulaire : ajouterFraudeConstatee(fraude)
activate Formulaire

Formulaire -> Formulaire : fraudes.add(fraude)

Formulaire -> Fraude : getEtudiants()
activate Fraude
Fraude --> Formulaire : liste des étudiants
deactivate Fraude

loop pour chaque étudiant de la fraude
    alt étudiant absent du formulaire
        Formulaire -> Formulaire : etudiants.add(etudiant)
    else étudiant déjà présent
        Formulaire -> Formulaire : ne rien faire
    end
end

Formulaire -> LocalDateTime : now()
LocalDateTime --> Formulaire : nouvelle date
Formulaire -> Formulaire : dateDerniereModification = nouvelle date

Formulaire --> User : void
deactivate Formulaire

@enduml